{
  "id": "antigravity",
  "name": "Google Antigravity IDE / CLI",
  "version": "4.0.0",
  "runtimeType": "ide-and-cli",
  "status": "supported",
  "officialDocs": [
    "https://www.antigravity.google/docs/rules/",
    "https://www.antigravity.google/docs/skills?tab=ide",
    "https://www.antigravity.google/docs/cli/features"
  ],
  "discovery": {
    "constitution": ["AGENTS.md", "GEMINI.md"],
    "skills": ".agents/skills/",
    "rules": ".agents/rules/",
    "agents": ".agents/agents/",
    "hooks": ".agents/hooks.json"
  },
  "instructions": {
    "primary": "AGENTS.md",
    "entryPoint": "GEMINI.md"
  },
  "skillsMapping": {
    "strategy": "direct",
    "canonicalPath": ".agents/skills/"
  },
  "roles": {
    "strategy": "native-subagents",
    "location": ".agents/agents/",
    "supportedRoles": [
      "planner",
      "implementer",
      "verifier",
      "evaluator",
      "reviewer",
      "security-reviewer",
      "researcher"
    ]
  },
  "safety": {
    "strategy": "deterministic-lifecycle-hooks",
    "hookConfig": ".agents/hooks.json",
    "policyPath": ".ai/policies/security-policy.json",
    "enforcer": ".ai/scripts/security-hook.js"
  },
  "execution": {
    "supportsSubagents": true,
    "supportsWorktrees": true,
    "supportsMcp": true,
    "supportsBrowser": true,
    "supportsParallel": true,
    "fallback": "Sequential execution if tasks share output boundaries"
  }
}
